<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The bundle is signed with the hardened runtime on (codesign reports
         the `runtime` flag), and under that a process cannot open an input
         device without this. The hardened runtime is also a precondition for
         notarization, so it is not optional now even if it once looked it. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
